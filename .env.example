# SmartRestaurant Multinational Distributed SaaS - Environment Configuration
# Copy this file to .env before starting the infrastructure

NODE_ENV=development
PORT=3000

# PostgreSQL 16 Multi-tenant Database
DATABASE_URL=postgresql://sr_admin:sr_secure_password_2026@localhost:5432/smartrestaurant_db
POSTGRES_DB=smartrestaurant_db
POSTGRES_USER=sr_admin
POSTGRES_PASSWORD=sr_secure_password_2026

# RabbitMQ 3.13 Message Broker (AMQP)
RABBITMQ_URL=amqp://sr_rabbit:sr_rabbit_pass_2026@localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=sr_rabbit
RABBITMQ_DEFAULT_PASS=sr_rabbit_pass_2026

# JWT & Security
JWT_SECRET=sr_super_secret_jwt_key_dist_2026
JWT_EXPIRATION=24h

# Microservices Ports (when run standalone)
AUTH_SERVICE_PORT=4001
RESTAURANT_SERVICE_PORT=4002
RESERVATION_SERVICE_PORT=4003
ORDER_SERVICE_PORT=4004
KITCHEN_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006
ANALYTICS_SERVICE_PORT=4007
