# SmartRestaurant — Variables de Entorno para Vercel + Supabase + Upstash QStash
# Copia este archivo a .env para desarrollo local o agrégalas en el dashboard de Vercel Project Settings > Environment Variables

# -----------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Persistente, Auth & RLS)
# Obtén estos valores en: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------
# URL de la API REST de tu proyecto Supabase
SUPABASE_URL=https://xyzprojectid.supabase.co

# Clave pública anónima (segura para usar en frontend bajo políticas RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_placeholder

# Clave de servicio privada (SOLO para funciones serverless en backend, con bypass de RLS)
# NUNCA expongas esta clave al frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key_placeholder

# -----------------------------------------------------------------------------
# 2. UPSTASH QSTASH (Mensajería Asíncrona Serverless & Webhooks)
# Obtén estos valores en: Upstash Console > QStash
# -----------------------------------------------------------------------------
# Token de acceso para publicar eventos hacia QStash
QSTASH_TOKEN=eyJVc2VySWQiOiJleGFtcGxlIiwicGFzc3dvcmQiOiJleGFtcGxlX3Rva2VuIn0=

# Clave de firma activa para validar la cabecera 'upstash-signature' en webhooks receptores
QSTASH_CURRENT_SIGNING_KEY=sig_current_example_key_abc123

# Clave de firma siguiente para rotación de secretos sin tiempo de inactividad
QSTASH_NEXT_SIGNING_KEY=sig_next_example_key_xyz789

# -----------------------------------------------------------------------------
# 3. APLICACIÓN WEB (URL Base del Despliegue en Vercel)
# -----------------------------------------------------------------------------
# URL pública de producción asignada por Vercel (utilizada por QStash como destino de webhooks)
APP_BASE_URL=https://smartrestaurant.vercel.app

# Secret para firma de tokens de sesión JWT
JWT_SECRET=sr_secure_serverless_jwt_secret_2026

# Entorno de ejecución
NODE_ENV=development
PORT=3000
