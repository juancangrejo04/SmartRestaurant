{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/events/qstash-receiver",
      "destination": "/api/events/qstash-receiver"
    },
    {
      "source": "/api/events/dispatch-outbox",
      "destination": "/api/events/dispatch-outbox"
    },
    {
      "source": "/api/events/history",
      "destination": "/api/events/history"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth/[...route]"
    },
    {
      "source": "/api/restaurants/(.*)",
      "destination": "/api/restaurants/[...route]"
    },
    {
      "source": "/api/reservations/(.*)",
      "destination": "/api/reservations/[...route]"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "/api/orders/[...route]"
    },
    {
      "source": "/api/kitchen/(.*)",
      "destination": "/api/kitchen/[...route]"
    },
    {
      "source": "/api/notifications/(.*)",
      "destination": "/api/notifications/[...route]"
    },
    {
      "source": "/api/analytics/(.*)",
      "destination": "/api/analytics/[...route]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
